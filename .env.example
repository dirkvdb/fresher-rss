# Companion container: URL reachable over the shared Docker network, without a trailing slash.
FRESHRSS_URL=http://freshrss

# The network that your existing FreshRSS container is already connected to.
FRESHRSS_NETWORK=freshrss_default

# FreshRSS Profile → Master authentication token, mapped by username.
# Enables the Refresh button to fetch new articles on FreshRSS itself.
FRESHRSS_REFRESH_TOKENS='{"reader":"replace-with-your-master-authentication-token"}'

# Optional: server-only API passwords for unread thumbnail and readable-content prefetching.
# Use the API password from FreshRSS Profile → API management, not the master token.
# FRESHRSS_API_PASSWORDS='{"reader":"replace-with-your-api-password"}'

# Docker Compose host binding / Nginx container port.
FRESHER_BIND_ADDRESS=0.0.0.0
FRESHER_PORT=8081
NGINX_PORT=80

# Node service (web-server upstreams are generated to match).
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
SERVER_UID=65534
SERVER_GID=65534

# Public UI defaults. Existing per-browser preferences take precedence.
FRESHER_DEFAULT_PALETTE=forest
FRESHER_DEFAULT_MODE=system
FRESHER_DEFAULT_FONT=serif
FRESHER_DEFAULT_FONT_SIZE=18
FRESHER_DEFAULT_SORT=newest
FRESHER_DEFAULT_UNREAD_ONLY=true
FRESHER_MARK_READ_ON_OPEN=true
FRESHER_PAGE_SIZE=50

# Public API endpoints (optional). Docker defaults to /freshrss-api;
# local development defaults to entering the FreshRSS URL at login.
# FRESHER_API_URL=/freshrss-api
# FRESHER_IMAGE_API_URL=api/article-image
# FRESHER_REFRESH_API_URL=api/refresh

# Image lookup / cache / rate limits.
IMAGE_ENABLED=true
# Disable to retain only the original on-demand image lookup behavior.
IMAGE_UNREAD_CACHE_ENABLED=true
# Shared unread-status polling interval for thumbnails and readable contents.
IMAGE_UNREAD_SYNC_INTERVAL_MS=300000
IMAGE_THUMBNAIL_MAX_BYTES=2097152
IMAGE_THUMBNAIL_CACHE_MAX_BYTES=67108864
IMAGE_TIMEOUT_MS=10000
IMAGE_DNS_TIMEOUT_MS=5000
IMAGE_MAX_HTML_BYTES=1048576
IMAGE_MAX_REDIRECTS=3
IMAGE_MAX_CONCURRENT=4
IMAGE_CACHE_MAX_ENTRIES=512
IMAGE_CACHE_TTL_SECONDS=86400
IMAGE_MISS_TTL_SECONDS=900
IMAGE_RATE_LIMIT=120
IMAGE_RATE_WINDOW_MS=60000
IMAGE_MAX_CLIENTS=512
IMAGE_MAX_URL_LENGTH=4096
IMAGE_MAX_CANDIDATES=8
IMAGE_ALLOWED_PORTS=80,443
# IMAGE_USER_AGENT=Mozilla/5.0 (compatible; FresherRSS/1.0; article image preview)

# Readable-content prefetching. Disable to keep only on-demand article extraction.
CONTENT_UNREAD_CACHE_ENABLED=true
CONTENT_UNREAD_CACHE_MAX_ENTRIES=512
CONTENT_UNREAD_CACHE_MAX_BYTES=67108864

# Feed refresh. HTTP cache/retry policy inside FreshRSS still applies.
REFRESH_ENABLED=true
REFRESH_API_TIMEOUT_MS=10000
REFRESH_FEED_TIMEOUT_MS=30000
REFRESH_TIMEOUT_MS=240000
REFRESH_MAX_CONCURRENT_USERS=2
REFRESH_FEED_CONCURRENCY=2
REFRESH_MAX_BODY_BYTES=8192
FRESHRSS_API_PATH=api/greader.php
FRESHRSS_REFRESH_PATH=i/

# HTTP server and web-server proxy settings.
HTTP_MAX_HEADER_BYTES=8192
HTTP_HEADERS_TIMEOUT_MS=5000
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=100
HTTP_MAX_HEADERS=30
SHUTDOWN_TIMEOUT_MS=11000
NGINX_SERVER_NAME=_
DNS_RESOLVER=127.0.0.11
DNS_RESOLVER_TTL_SECONDS=30
DNS_IPV6=false
STATIC_CACHE_SECONDS=3600
FRESHRSS_PROXY_TIMEOUT_MS=30000
FRESHRSS_TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# Browser timeouts/cache/concurrency automatically follow service settings;
# uncomment to override them independently.
# FRESHER_API_TIMEOUT_MS=30000
# FRESHER_IMAGE_CLIENT_TIMEOUT_MS=15000
# FRESHER_REFRESH_CLIENT_TIMEOUT_MS=300000
# FRESHER_IMAGE_CLIENT_CONCURRENCY=4
# FRESHER_IMAGE_CACHE_TTL_SECONDS=86400
# FRESHER_IMAGE_MISS_TTL_SECONDS=900
